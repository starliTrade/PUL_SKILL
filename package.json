{
  "name": "pulsar-duels",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint . --max-warnings 0",
    "verify": "bash scripts/verify.sh",
    "verify:strict": "bash scripts/verify.sh --strict",
    "test:server": "sh -c '.venv/bin/python scripts/test_game_server.py || python3 scripts/test_game_server.py'",
    "test:contract": "node contracts/test/compile_check.js",
    "test:http": "sh -c '.venv/bin/python scripts/test_http_e2e.py || python3 scripts/test_http_e2e.py'",
    "test:firestore": "sh -c '.venv/bin/python scripts/test_firestore_integration.py || python3 scripts/test_firestore_integration.py'",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:cov": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@walletconnect/ethereum-provider": "^2.24.0",
    "@walletconnect/modal": "^2.7.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "solc": "0.8.20",
    "tailwindcss": "^4.1.14",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
