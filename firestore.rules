rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // P0.6 — ECONOMY LOCKDOWN
    //
    // Clients are untrusted. Without a verified backend (P1 game server via
    // Admin SDK, which bypasses these rules), no client may grant itself
    // wins, XP, level, match count, vault balance, or identity fields. The
    // SIWE-authenticated API is the sole writer; clients consume projections.

    match /users/{userId} {
      // Profiles may contain private friend/history fields. Public surfaces
      // read the sanitized leaderboard projection instead.
      allow read: if false;
      // Wallet signatures cannot be verified by Firestore rules. All writes
      // flow through the SIWE-authenticated API (Admin SDK bypasses rules).
      allow create, update: if false;
      allow delete: if false;
    }

    // Self-reported match results and leaderboard rows are not trustworthy.
    // Only the settlement server writes these collections.
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if false;
    }

    // Username registry: unique by document id. A registration can never be
    // re-pointed to a different address (anti-takeover).
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
