rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // P0.6 — ECONOMY LOCKDOWN
    //
    // Clients are untrusted. Without a verified backend (P1 game server via
    // Admin SDK, which bypasses these rules), no client may grant itself
    // wins, XP, level, match count, or vault balance. Profile-only fields
    // (player tag, saved friends, practice benchmarks) remain editable.

    function economyUnchanged() {
      return request.resource.data.wins == resource.data.wins
        && request.resource.data.losses == resource.data.losses
        && request.resource.data.voids == resource.data.voids
        && request.resource.data.totalMatches == resource.data.totalMatches
        && request.resource.data.xp == resource.data.xp
        && request.resource.data.level == resource.data.level
        && request.resource.data.vaultBalance == resource.data.vaultBalance;
    }

    match /users/{userId} {
      // Audit M-19 (2026-10-22): this used to be `allow read: if true`.
      //
      // The document is the SETTLEMENT LEDGER: wallet address, wins/losses/XP,
      // reaction averages, history and friend graph. World-readable meant any
      // visitor could enumerate every player and their economic profile, and a
      // cheater could scout an opponent's reaction average before choosing a
      // stake. The only reason it was public was the friend search — which now
      // runs through GET /api/players/search (five display fields, session
      // required), and the podium reads the separate `leaderboard` collection.
      allow read: if false;
      // New profiles must start with a zeroed economy — no self-granted stats.
      // OWNERSHIP (audit #10 item 8): a create must address the caller's OWN
      // wallet. There is no Firebase Auth in this deployment, so ownership is
      // proven with the same signature the game server already verifies
      // (EIP-191 personal_sign over the fixed SIWE-statement string). The
      // server (Admin SDK) is not bound by these rules and keeps writing
      // economy counters after settlements.
      // NOTE: with no client-side firebase/auth wiring yet, the effective
      // policy today is "creates only via the Admin SDK" — the game server's
      // ledger is the legitimate writer; the legacy anonymous self-create is
      // closed.
      // P0-fix: profile defacement closed. Previously `allow update: if
      // economyUnchanged()` let ANY unauthenticated client rewrite anyone's
      // bestReactionMs/avgReactionMs/savedFriends/playerId/address (only 7
      // economy counters were pinned). There is no Firebase Auth in this
      // deployment, so per-user ownership cannot be proven in rules — ALL
      // writes go through the game server (Admin SDK, bypasses rules).
      // Clients are read-only here; profile edits must use /api/username/claim
      // and future authenticated profile endpoints.
      allow create: if false;
      // Updates may edit the profile, never the economy.
      allow update: if false;
      allow delete: if false;
    }

    // Self-reported match results and leaderboard rows are not trustworthy.
    // Only the settlement server writes these collections.
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if false;
    }

    // Audit #7 R4 — the server's distributed rate limiter lives in
    // rate_limits/{rl:*}. No client may read or write it: a write would reset
    // an abuser's own window (self-help), and a read maps private request
    // cadence.
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // Username registry: unique by document id. A registration can never be
    // re-pointed to a different address (anti-takeover).
    // Audit #10 (item 8): the legacy client-write create only validated the
    // address FORMAT — no proof the caller owned it (squatting / identity
    // theft). Claims now run through the game server's authenticated,
    // idempotent /api/username/claim (Admin SDK), so clients get read-only
    // access here.
    match /usernames/{username} {
      // Audit M-19: `read: if true` turned the registry into a name→address
      // enumeration oracle (who owns "nova"?). Availability is answered by the
      // authenticated, rate-limited GET /api/username/{name}, which reports only
      // whether the caller may take the name.
      allow read: if false;
      allow write: if false;
    }
  }
}
