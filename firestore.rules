rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /matches/{matchId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if true;
    }
  }
}
