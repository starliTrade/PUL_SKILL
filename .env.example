# ==========================================
# Pulsar Protocol - Production Configuration
# ==========================================

# 1. Your Personal/Company Treasury Wallet (Receives 2.0% Rake Fee from all settled matches)
TREASURY_WALLET_ADDRESS=0x1337BEEF892e105Ec64dB1A7036a1476bF79E89D

# 2. Anti-Cheat Server Oracle Keypair (Used for cryptographic EIP-712 settlement signing)
ORACLE_WALLET_ADDRESS=0x9E7F4b238C19AcB952b7a0d421865E193Fa12480
ORACLE_SIGNING_SECRET=PULSAR_ORACLE_SECRET_SEED_2026

# 3. Default EVM Network
# Options: polygonAmoy (testnet $0), arbitrumSepolia (testnet $0), polygonMainnet
DEFAULT_NETWORK=polygonAmoy

# 4. WalletConnect / Reown Cloud Project ID (Optional - defaults to official tested project ID)
VITE_WALLETCONNECT_PROJECT_ID=
