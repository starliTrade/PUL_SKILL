# Server (never expose private values through VITE_ variables)
ORACLE_SIGNING_SECRET=
# Prefer a separate long random value in production. When omitted, round
# proofs derive from ORACLE_SIGNING_SECRET for backwards compatibility.
RESULT_PROOF_SECRET=
ORACLE_PRIVATE_KEY=
ORACLE_CHAIN_ID=80002
ESCROW_ADDRESS=
PULSAR_MATCH_STORE=firestore
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Exact frontend origins, comma-separated (for example https://app.example.com).
# Leave empty only when frontend and API are served from the same origin.
CORS_ALLOW_ORIGINS=
ALLOWED_DOMAIN=

# Browser client
VITE_GAME_SERVER_URL=
VITE_CHAIN_ID=80002
VITE_ESCROW_ADDRESS=
VITE_PAYMENT_TOKEN_ADDRESS=
VITE_ORACLE_WALLET_ADDRESS=
VITE_TREASURY_WALLET_ADDRESS=
VITE_WALLETCONNECT_PROJECT_ID=
VITE_FAUCET_URL=
