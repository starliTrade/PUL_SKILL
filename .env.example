# PULSAR — environment reference (plan item 6.7).
#
# Copy to `.env.local` (client, git-ignored) and/or export on the server host.
# NOTHING here has a default that enables real money: with the escrow address
# unset the app runs in honest practice-only mode.
#
# The previous version of this file listed six variables, four of which nothing
# reads (`DEFAULT_NETWORK`, `FIREBASE_API_KEY`, `ORACLE_WALLET_ADDRESS`,
# `TREASURY_WALLET_ADDRESS` — the real names are the VITE_-prefixed ones below).
# An operator following it would have configured a deployment that ignores
# everything they set.

# --- client (Vite; must be prefixed VITE_ to reach the bundle) ----------------

# Escrow contract. UNSET = practice-only mode (no real money). Set it on Amoy
# first; see docs/DEPLOYMENT.md.
VITE_ESCROW_ADDRESS=
# Payment token (USDT). On Amoy leave unset to use the deployed MockUSDT.
VITE_PAYMENT_TOKEN_ADDRESS=
# Chain id the client expects (80002 = Polygon Amoy, 137 = Polygon mainnet).
VITE_CHAIN_ID=80002
# The local chain (31337): `scripts/start_anvil.sh --bg` deploys the escrow
# there. Set VITE_CHAIN_ID=31337 to point the app at it.
VITE_LOCAL_RPC_URL=
# Game server base URL. Defaults to same-origin when unset.
VITE_API_URL=
# Alias accepted for the same value (older deployments used this name).
VITE_GAME_SERVER_URL=
# WalletConnect / Reown Cloud project id — required for mobile wallet apps.
# Free at cloud.reown.com. Without it, mobile pairing fails with a clear error
# instead of riding a shared relay identity.
VITE_WALLETCONNECT_PROJECT_ID=
# Public addresses (safe to ship in the bundle; they must match the deployment).
VITE_ORACLE_WALLET_ADDRESS=
VITE_TREASURY_WALLET_ADDRESS=
# Optional: a faucet link shown on testnet.
VITE_FAUCET_URL=
# Optional: error monitoring. Unset = the Sentry SDK is never even loaded.
VITE_SENTRY_DSN=
# Optional: release label attached to reported errors.
VITE_APP_VERSION=

# --- client: Firestore (leaderboard + profile sync) ---------------------------
# All four of the first group are required together; without them the cloud
# layer is disabled honestly (local-only play, "no matches yet" leaderboard).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# --- server (api/) ------------------------------------------------------------

# REQUIRED. The server refuses to start without it: result-proof keys are
# derived from this secret, and a per-process random key would split
# commit/reveal across replicas.
ORACLE_SIGNING_SECRET=
# REQUIRED for settlement. The oracle signer's private key. Store it as a
# platform secret — never in a file that reaches the repository.
ORACLE_PRIVATE_KEY=
# REQUIRED. The deployed escrow contract address.
ESCROW_ADDRESS=
# The oracle signer's public address (must match the contract's oracleSigner).
ORACLE_ADDRESS=
# The treasury address (must match the contract's treasuryWallet).
TREASURY_ADDRESS=
# Chain id the server signs for. Must match the client and the contract.
ORACLE_CHAIN_ID=80002
# RPC endpoint used for the deposit gate and claim verification.
ESCROW_RPC_URL=

# The host the server is reachable at. REQUIRED when the escrow is configured:
# the SIWE domain is taken from here, not from the client's Host header
# (audit H7 — a spoofed Host header would otherwise let an attacker choose the
# domain the user signs for).
ALLOWED_DOMAIN=
# The hostnames THIS API answers to (comma-separated). Defaults to
# ALLOWED_DOMAIN, which is only correct when the frontend and API share a host.
# In the split topology (frontend app.example.com, API api.example.com) set
# ALLOWED_HOSTS=api.example.com or every request is rejected with 403.
ALLOWED_HOSTS=
PUBLIC_HOST=
# Comma-separated CORS origins. In production an unset value is refused rather
# than defaulting to "*".
CORS_ALLOW_ORIGINS=
# Set to "dev" ONLY for a local run. Every other value is treated as production
# and requires the full configuration above (audit H6 — fail closed).
PULSAR_ENV=dev
# Match store backend: "firestore" for the durable store, anything else for the
# in-memory one (tests only).
PULSAR_MATCH_STORE=
# Admin tooling (phase 6.3) — a shared secret for /api/admin/*.
PULSAR_ADMIN_SECRET=
# Firestore credentials for the server (Admin SDK). Prefer a workload identity
# in production; this is for environments that must pass a service account.
FIRESTORE_CREDENTIALS_JSON=
FIRESTORE_PROJECT_ID=
# Only set this behind a proxy you control: it makes the server trust
# X-Forwarded-For for rate limiting.
TRUST_PROXY_HEADERS=
# Optional server-side error monitoring (Sentry).
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- contracts (Deploy.s.sol) -------------------------------------------------

# Canonical USDT address. Leave unset on Amoy to deploy MockUSDT.
PAYMENT_TOKEN_ADDRESS=
